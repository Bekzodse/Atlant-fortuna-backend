# Copy this file to .env.local and fill in real values.

# Base URL of the backend API (no /api/v1 suffix — each lib/api/*.ts module appends it).
# Point at the production backend if you don't want to run it locally:
# NEXT_PUBLIC_API_URL=https://atlant-backend-production.up.railway.app
NEXT_PUBLIC_API_URL=http://localhost:8080
