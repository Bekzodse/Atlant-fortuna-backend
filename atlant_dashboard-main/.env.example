# Copy this file to .env.local and fill in real values.

# Base URL of the backend API (includes /api/v1 — unlike the public frontend's env var).
# Point at the production backend if you don't want to run it locally:
# NEXT_PUBLIC_API_URL=https://atlant-backend-production.up.railway.app/api/v1
NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1
