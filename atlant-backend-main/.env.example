# Copy this file to .env and fill in real values. Never commit .env.

# Postgres connection — matches docker-compose.yml in this directory by default.
DATABASE_URL=jdbc:postgresql://localhost:5433/atlant
DATABASE_USERNAME=atlant
DATABASE_PASSWORD=atlant_local_dev

# AWS S3 — required for product/gallery/license/team image uploads.
# Ask a teammate for the shared bucket credentials.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_BUCKET_NAME=

# Any random long string works locally; use a real secret in production.
JWT_SECRET_KEY=

# Optional. If omitted, Telegram notifications are skipped (a warning is logged,
# nothing breaks). Once the app is running, the active bot/chat can also be
# configured from the admin dashboard, which takes priority over these.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
